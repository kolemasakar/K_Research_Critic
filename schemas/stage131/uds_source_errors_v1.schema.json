{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage131 source-supported UDS response errors v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ],
      "properties": {
        "status": {
          "const": "rejected"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "request_id",
        "error"
      ],
      "properties": {
        "status": {
          "const": "pending_reconciliation"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "enum": [
            "OPERATION_DENIED",
            "UNAUTHORIZED",
            "NOT_FOUND",
            "INVALID_REQUEST",
            "UNSUPPORTED_MEDIA_TYPE",
            "REQUEST_TOO_LARGE"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ],
      "properties": {
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "const": "RESPONSE_TOO_LARGE"
            }
          }
        }
      }
    }
  ]
}
