{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KRC Stage131 UDS observed outbound response bundle, source contract candidate",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "version",
        "request_id",
        "status",
        "delivery",
        "result"
      ],
      "properties": {
        "version": {
          "const": "krc-transport/2"
        },
        "request_id": {
          "type": "string"
        },
        "status": {
          "const": "completed"
        },
        "delivery": {
          "const": "inline"
        },
        "result": {
          "type": "object",
          "allOf": [
            {
              "if": {
                "required": [
                  "scientific_approval"
                ]
              },
              "then": {
                "properties": {
                  "scientific_approval": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "engine_result"
                ]
              },
              "then": {
                "properties": {
                  "engine_result": {
                    "type": "object",
                    "properties": {
                      "scientific_approval": {
                        "const": false
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "scientific_approval"
                ]
              },
              "then": {
                "required": [
                  "task_id",
                  "operation",
                  "status",
                  "engine_result"
                ],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation": {
                    "enum": [
                      "research.profile.validate",
                      "research.evidence.preflight",
                      "research.bibliography.audit",
                      "research.inspection.review"
                    ]
                  },
                  "status": {
                    "enum": [
                      "PENDING",
                      "REVISE"
                    ]
                  },
                  "engine_result": {
                    "type": "object"
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "version",
        "request_id",
        "status",
        "delivery",
        "artifact"
      ],
      "properties": {
        "version": {
          "const": "krc-transport/2"
        },
        "request_id": {
          "type": "string"
        },
        "status": {
          "const": "completed"
        },
        "delivery": {
          "const": "artifact"
        },
        "artifact": {
          "type": "object",
          "required": [
            "artifact_id",
            "filename",
            "media_type",
            "size_bytes",
            "sha256",
            "expires_at_epoch"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{48}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "media_type": {
              "type": "string",
              "minLength": 1
            },
            "expires_at_epoch": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "status",
        "error"
      ],
      "properties": {
        "status": {
          "enum": [
            "rejected",
            "pending_reconciliation"
          ]
        },
        "request_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "status",
        "error"
      ],
      "properties": {
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "const": "RESPONSE_TOO_LARGE"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "production"
      ],
      "properties": {
        "status": {
          "const": "staging"
        },
        "production": {
          "const": false
        }
      }
    }
  ]
}
