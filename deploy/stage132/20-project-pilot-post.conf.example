# REVIEW ONLY. Existing gateway unit drop-in; no separate public endpoint.
# Do not install until exact source and operator rollback reviewed.
[Service]
WorkingDirectory=/opt/krc-research-v2
Environment=PYTHONPATH=/opt/krc-stage132-post/current/gateway-src:/opt/krc-research-v2/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=
ExecStart=/opt/krc-research-v2/.venv/bin/python -s -m krc_research.stage132_project_post_runtime gateway --enable-reviewed-staging-post
# Do not bind-mount the broker runtime directory into the gateway namespace.
# Its socket inode must remain discoverable after independent broker restart.
# Existing ProtectSystem=strict and kernel peer/HMAC controls remain.
