{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KRC Stage131 internal artifact GET signed UDS envelope candidate v1 (NOT DEPLOYED)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operation",
    "request_id",
    "artifact_id",
    "identity",
    "auth"
  ],
  "properties": {
    "version": {
      "const": "krc-artifact-get/1"
    },
    "operation": {
      "const": "artifact.read"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{48}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "repository",
        "workflow_ref"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "workflow_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "issued_at_epoch",
        "nonce",
        "mac_sha256"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "issued_at_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "nonce": {
          "type": "string",
          "minLength": 16
        },
        "mac_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
