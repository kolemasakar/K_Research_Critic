# KRC owner-approved separate staging-only user service template.
# Install as ~/.config/systemd/user/krc-public-doi-staging.service
# under krcops. Never replace an installed /opt KRC/Sentinel unit.
[Unit]
Description=KRC read-only scholarly MCP DOI staging (rollback)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/krcops/krc-stage131-doi-staging/releases/23418dda183ea2af818dcb746a24abc7fd83df0a
Environment=PYTHONPATH=/home/krcops/krc-stage131-doi-staging/releases/23418dda183ea2af818dcb746a24abc7fd83df0a/src
Environment=KRC_PRIVATE_RESEARCH_PORT=19147
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=KRC_SENTINEL_SCIENCE_KEY_FILE=
ExecStart=/opt/krc-public-mcp/venv/bin/python -B -m krc_research.mcp_private_server
Restart=on-failure
RestartSec=2
TimeoutStartSec=20
TimeoutStopSec=12
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# No [Install] section: explicit operator-controlled staging only.
